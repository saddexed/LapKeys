<UserControl x:Class="LapKeys.Views.HotkeyRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:LapKeys.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="400"
             x:Name="Root">
    
    <UserControl.Resources>
        <helpers:HotkeyButtonTextConverter x:Key="HotkeyButtonTextConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- Label -->
        <TextBlock Grid.Column="0" 
                   Text="{Binding Label, ElementName=Root}" 
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
        
        <!-- Hotkey Display Box -->
        <Border Grid.Column="1"
                Background="{DynamicResource SubtleBrush}" 
                CornerRadius="6"
                Padding="12,8"
                HorizontalAlignment="Left">
            <TextBlock Text="{Binding DisplayText, ElementName=Root}" 
                       FontFamily="Segoe UI"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
        
        <!-- Set/Cancel Button -->
        <Button Grid.Column="2"
                Command="{Binding DataContext.ToggleCaptureHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding HotkeyType, ElementName=Root}"
                Style="{DynamicResource ModernButtonStyle}">
            <Button.Content>
                <MultiBinding Converter="{StaticResource HotkeyButtonTextConverter}">
                    <Binding Path="DataContext.IsCapturingHotkey" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    <Binding Path="DataContext.CapturingHotkeyType" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    <Binding Path="HotkeyType" ElementName="Root"/>
                </MultiBinding>
            </Button.Content>
        </Button>
    </Grid>
</UserControl>
